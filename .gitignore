# Spendly .gitignore

# Database
*.db
*.db-journal
*.db-wal
*.db-shm
spendly.db
data/
backend/data/

# Backend Build & Dependencies
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class

# Frontend Build & Dependencies
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Environment Variables and Secrets
.env
.env.*
!.env.example
*.key
*.pem

# IDE & Editor Specific
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
